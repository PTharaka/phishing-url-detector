ENABLE_RDAP=1
ENABLE_TLS_INTEL=1
ENABLE_HOSTING_INTEL=1
ENABLE_PASSIVE_DNS=0
ENABLE_VISION_AI=0
PHISHGUARD_SCAN_DIR=static/scans
MAX_LIVE_REPUTATION_PER_REQUEST=20
RIPESTAT_SOURCEAPP=phishguard_v5
HOSTING_INTEL_TIMEOUT=5
TLS_TIMEOUT=5
BROWSER_TIMEOUT_MS=15000
BROWSER_MAX_REQUESTS=40
SECURITYTRAILS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000